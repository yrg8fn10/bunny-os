#!/usr/bin/env python3
"""Installed entry point for the Bun Bun CLI.

Works both from the repo (../bunbun) and from /opt/bunbun/bin.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from bunbun.cli import main  # noqa: E402

raise SystemExit(main())
