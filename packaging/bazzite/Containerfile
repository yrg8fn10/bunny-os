# =============================================================================
#  Bunny OS on Bazzite - Steam Deck LCD
# -----------------------------------------------------------------------------
#  Layers the Bunny OS payload (Control Panel, its bridge and the first-boot
#  wizard) on top of the official Bazzite Deck image, so the machine keeps the
#  boot chain, kernel, firmware and Gaming Mode that are known to work on the
#  Deck, and still gets Bunny OS on top.
#
#  Everything is baked into the immutable image: no first-boot installer, no
#  /usr/local, nothing that an rpm-ostree update would wipe. The only runtime
#  state is /var/lib/bunny (the setup marker and the audit log).
#
#  Build (CI does this, see .github/workflows/build-bazzite-iso.yml):
#      scripts/build-portable.sh
#      cp out/bunny-os-portable-*.tar.gz packaging/bazzite/bunny-os-portable.tar.gz
#      podman build -t localhost/bunny-deck:latest packaging/bazzite/
#
#  This is the image that ends up on the Deck.  The ISO is built from a
#  separate live medium, because booting this image would start Gaming Mode:
#  see Containerfile.live.
# =============================================================================
ARG BASE_IMAGE=ghcr.io/ublue-os/bazzite-deck:stable
FROM ${BASE_IMAGE}

# The Bun Bun agent and the panel are stdlib Python and a dependency-free web
# UI. Chromium is the one thing we add: the Deck has no terminal browser and
# the wizard has to render before anything is installed.
RUN set -eux; \
    dnf install -y --setopt=install_weak_deps=False python3 chromium espeak-ng python3-pip python3-pillow; \
    dnf clean all; \
    rm -rf /var/cache/dnf /var/cache/libdnf5

COPY bunny-os-portable.tar.gz /tmp/bunny-os-portable.tar.gz

# BUNNY_INSTALL_IMAGE tells the portable installer it is running inside an
# image build: enable the unit, never try to start it, and never reload a
# daemon that does not exist yet.
RUN set -eux; \
    tar -xzf /tmp/bunny-os-portable.tar.gz -C /tmp; \
    BUNNY_INSTALL_IMAGE=1 /tmp/bunny-os-portable-*/install.sh --prefix /usr; \
    rm -rf /tmp/bunny-os-portable*

COPY decky-theme/ /usr/share/bunny-os/decky-theme/
COPY boot-movie/ /usr/share/bunny-os/boot-movie/
COPY bunny-decky-theme /usr/bin/bunny-decky-theme
RUN chmod 0755 /usr/bin/bunny-decky-theme

# Decky Loader is NOT baked in since pre9: baking it made bunny-decky-init run
# at boot and touch Steam's own home dir before Steam's first-run setup, which
# can trip "couldn't set up steam data". The image now carries only the payload
# digest; bunny-decky-init (enabled below) downloads the pinned payload from
# the update channel and installs it after the setup wizard runs and Steam's
# data exists. Smaller image, and the setup starts from the wizard.
COPY decky-payload.sha256 /usr/share/bunny-os/decky-payload.sha256
COPY decky-init/bunny-decky-init /usr/bin/bunny-decky-init
COPY decky-init/bunny-decky-init.service /etc/systemd/system/bunny-decky-init.service
RUN set -eux; \
    chmod 0755 /usr/bin/bunny-decky-init; \
    mkdir -p /etc/systemd/system/multi-user.target.wants; \
    ln -sfn ../bunny-decky-init.service /etc/systemd/system/multi-user.target.wants/bunny-decky-init.service; \
    test -f /usr/share/bunny-os/decky-payload.sha256; \
    grep -Eq "^[0-9a-f]{64}" /usr/share/bunny-os/decky-payload.sha256

# The host's session, greeter and account stay Bazzite's. The wizard only
# writes the marker and the network/time-zone settings.
RUN set -eux; \
    mkdir -p /var/lib/bunny; \
    chmod 0755 /var/lib/bunny; \
    test -x /usr/bin/bunny-setupd; \
    test -f /usr/lib/bunny/ui/setup/index.html; \
    test -f /usr/lib/systemd/system/bunny-setupd.service; \
    test -f /usr/lib/bunny/bunbun/bunbun/service.py; \
    test -f /usr/share/backgrounds/bunny-os/bunny-glow.png; \
    test -f /usr/share/backgrounds/bunny-os/bunny-desktop.png; \
    test -f /usr/share/backgrounds/bunny-os/bunny-game-mode.png; \
    test -d /usr/share/bunny-os/decky-theme/bunny-cute; \
    test -f /usr/share/bunny-os/boot-movie/bunny-os-boot.webm; \
    test -f /usr/share/applications/bunny-os.desktop; \
    test -f /usr/lib/systemd/user/bunny-bunbun.service; \
    test -f /usr/lib/systemd/user/bunny-bunhud.service; \
    test -f /usr/lib/bunny/bunhud/bunhud.py; \
    test -f /usr/lib/bunny/bunhud/assets/bunhud-placeholder.png; \
    python3 -c "import PIL"; \
    test -x /usr/bin/piper; \
    test -f /usr/share/bunbun/voices/bunny-default.onnx

# Bun Bun boot branding: replace the upstream Bazzite boot splash with the
# Bun Bun Plymouth theme, so booting into Gaming Mode shows the bunny, not
# Bazzite's logo. The default.plymouth symlink lives in /usr, so the theme
# survives rpm-ostree updates.
# bunhud: the Game Mode presence layer. It talks to the compositor through
# pywayland, installed into the bunhud tree so it travels with the image and
# never fights the system Python. Pillow comes from the Fedora repo.
RUN set -eux; \
    dnf install -y --setopt=install_weak_deps=False gcc pkgconf-pkg-config wayland-devel wayland-protocols libffi-devel; \
    dnf clean all; \
    python3 -m pip install --no-cache-dir --target /usr/lib/bunny/bunhud/pylibs pywayland==0.4.19; \
    rm -rf /usr/lib/bunny/bunhud/pylibs/bin

COPY just/bunhud.just /usr/share/ublue-os/just/bunhud.just
RUN set -eux; \
    J=/usr/share/ublue-os/justfile; \
    if [ -f "$J" ] && ! grep -q "bunhud.just" "$J"; then \
      grep -q "just/\*" "$J" || printf "import? 'just/bunhud.just'\n" >> "$J"; \
    fi

COPY plymouth-bunbun/ /tmp/bunny-branding/
RUN set -eux; \
    install -d /usr/share/plymouth/themes/bunbun; \
    install -m 0644 /tmp/bunny-branding/bunbun.plymouth /usr/share/plymouth/themes/bunbun/; \
    install -m 0644 /tmp/bunny-branding/bunbun-logo.png /usr/share/plymouth/themes/bunbun/; \
    ln -sfn bunbun/bunbun.plymouth /usr/share/plymouth/themes/default.plymouth; \
    printf '[Daemon]\nTheme=bunbun\n' > /etc/plymouth/plymouthd.conf; \
    rm -rf /tmp/bunny-branding; \
    readlink /usr/share/plymouth/themes/default.plymouth | grep -q bunbun; \
    test -f /usr/share/plymouth/themes/bunbun/bunbun-logo.png

ARG BUNNY_VERSION=0.0.0
LABEL org.opencontainers.image.title="Bunny OS (Bazzite Deck base)" \
      org.opencontainers.image.description="Bazzite Deck with the Bunny OS Control Panel and first-boot wizard" \
      org.opencontainers.image.version="${BUNNY_VERSION}" \
      org.opencontainers.image.vendor="Bunny OS" \
      com.bunny-os.variant="bazzite-deck"
