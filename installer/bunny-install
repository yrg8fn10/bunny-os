#!/usr/bin/env bash
# =============================================================================
#  bunny-install — guided installer for Bunny OS (UEFI only, v0.1)
#
#  This is a whole-disk installer. It erases the selected drive, creates a
#  512 MiB ESP plus a Btrfs root with @/@home/@var/@snapshots subvolumes, then
#  copies the running live image, writes an fstab, creates the user, enables
#  the Bunny OS units and installs systemd-boot.
#
#  It deliberately does NOT support dual-boot, encryption or BIOS firmware yet.
#  Refusing loudly is better than half-installing next to someone's data.
#
#  Usage: bunny-install [--disk /dev/nvme0n1] [--hostname NAME] [--user NAME]
#                       [--timezone Area/City] [--locale en_US.UTF-8]
#                       [--yes] [--dry-run]
# =============================================================================
set -Eeuo pipefail

DISK=""
HOSTNAME="bunnyos"
USERNAME="bunny"
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"
ASSUME_YES=0
DRY_RUN=0
TARGET="/mnt"
PASSWORD="${BUNNY_PASSWORD:-}"
KEEP_HOME_FROM=""

usage() {
  sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
}

while (( $# > 0 )); do
  case "$1" in
    --disk)     DISK="${2:?--disk needs a device}"; shift 2 ;;
    --hostname) HOSTNAME="${2:?}"; shift 2 ;;
    --user)     USERNAME="${2:?}"; shift 2 ;;
    --timezone) TIMEZONE="${2:?}"; shift 2 ;;
    --locale)   LOCALE="${2:?}"; shift 2 ;;
    --keep-home-from) KEEP_HOME_FROM="${2:?--keep-home-from needs a disk}"; shift 2 ;;
    --yes|-y)   ASSUME_YES=1; shift ;;
    --dry-run)  DRY_RUN=1; shift ;;
    --help|-h)  usage; exit 0 ;;
    *) echo "bunny-install: unknown argument $1" >&2; exit 2 ;;
  esac
done

log()  { printf '\033[1;35m[bunny-install]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[bunny-install]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[bunny-install] ERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# Per-target profile written at build time (e.g. Steam Deck LCD). The kernel
# arguments must follow the install: a Deck install without amd_pstate=active
# would still boot, but would not match the tested configuration.
TARGET_LABEL="generic"
EXTRA_KERNEL_ARGS=""
if [[ -r /etc/bunny/target.conf ]]; then
  # shellcheck disable=SC1090,SC1091
  source /etc/bunny/target.conf
  TARGET_LABEL="${BUNNY_TARGET_NAME:-${BUNNY_TARGET_ID:-generic}}"
  EXTRA_KERNEL_ARGS="${BUNNY_KERNEL_ARGS:-}"
fi

# Values below are interpolated into a chroot script and an SDDM drop-in, so
# refuse anything that is not a plain POSIX-ish account or hostname.
[[ "${USERNAME}" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] \
  || die "invalid username '${USERNAME}' (lower-case letters, digits, _ and -, max 32)"
[[ "${HOSTNAME}" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$ ]] \
  || die "invalid hostname '${HOSTNAME}'"
[[ "${TIMEZONE}" =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ ]] \
  || die "invalid timezone '${TIMEZONE}' (expected Area/City)"
[[ "${LOCALE}" =~ ^[a-z]{2,3}_[A-Z]{2}(\.[A-Za-z0-9-]+)?$ ]] \
  || die "invalid locale '${LOCALE}' (expected e.g. en_US.UTF-8)"

trap 'die "installation failed on line ${LINENO}. The target may be partially written; boot the live image again and retry."' ERR

# ---------------------------------------------------------------------------
# Preflight
# ---------------------------------------------------------------------------
[[ "${EUID}" -eq 0 ]] || die "must run as root (use pkexec or sudo)"
[[ -d /run/archiso ]] || die "run this from the Bunny OS live image"
[[ -d /sys/firmware/efi ]] || die "UEFI firmware is required; BIOS install is not implemented in v0.1"

for tool in sgdisk mkfs.fat mkfs.btrfs mount umount lsblk rsync genfstab arch-chroot blkid; do
  command -v "${tool}" >/dev/null 2>&1 || die "missing required tool: ${tool}"
done

if [[ -z "${DISK}" ]]; then
  mapfile -t DISKS < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk" {model=""; for (i=3; i<NF; i++) model=model" "$i; print $1"\t"$2"\t"model}')
  (( ${#DISKS[@]} > 0 )) || die "no disks found"
  if (( ASSUME_YES )); then
    die "no --disk given and --yes was set; refusing to guess"
  fi
  echo "Available disks:"
  select choice in "${DISKS[@]}"; do
    [[ -n "${choice:-}" ]] || die "invalid selection"
    DISK="${choice%%$'\t'*}"
    break
  done
fi

[[ -b "${DISK}" ]] || die "${DISK} is not a block device"
DISK="$(readlink -f "${DISK}")"

# Never erase the USB stick the live image is running from.
LIVE_DISK=""
if command -v findmnt >/dev/null 2>&1; then
  LIVE_SRC="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -b "${LIVE_SRC}" ]]; then
    LIVE_PK="$(lsblk -no PKNAME "${LIVE_SRC}" | head -n1)"
    [[ -n "${LIVE_PK}" ]] && LIVE_DISK="/dev/${LIVE_PK}"
  fi
fi
if [[ -n "${LIVE_DISK}" && "${DISK}" == "${LIVE_DISK}" ]]; then
  die "refusing to install onto the running live USB (${LIVE_DISK})"
fi

SIZE_BYTES="$(lsblk -bno SIZE "${DISK}" | head -n1)"
(( SIZE_BYTES >= 16 * 1024 * 1024 * 1024 )) \
  || die "target is smaller than 16 GiB; Bunny OS needs room for games and updates"

if lsblk -no MOUNTPOINT "${DISK}" | grep -qv '^$'; then
  die "${DISK} has mounted partitions. Unmount them, then retry."
fi

part() {
  local disk="$1" number="$2"
  if [[ "${disk}" =~ [0-9]$ ]]; then
    printf '%s' "${disk}p${number}"
  else
    printf '%s' "${disk}${number}"
  fi
}

ESP="$(part "${DISK}" 1)"
ROOT="$(part "${DISK}" 2)"

cat <<EOF

  Bunny OS will ERASE this disk:

    disk        ${DISK}  ($(numfmt --to=iec-i --suffix=B "${SIZE_BYTES}" 2>/dev/null || echo "${SIZE_BYTES} bytes"))
    target      ${TARGET_LABEL}
    ESP         ${ESP}   512 MiB, FAT32, systemd-boot
    root        ${ROOT}  remaining space, Btrfs (@, @home, @var, @snapshots)
    hostname    ${HOSTNAME}
    user        ${USERNAME} (wheel, audio, video, input, render)
    timezone    ${TIMEZONE}
    locale      ${LOCALE}

  There is no dual-boot and no disk encryption in this version.
  Every partition and every file on this disk will be destroyed.

EOF

if (( DRY_RUN )); then
  log "dry run: no changes made"
  exit 0
fi

if (( ! ASSUME_YES )); then
  read -r -p "Type ERASE to continue: " answer
  [[ "${answer}" == "ERASE" ]] || die "cancelled"
fi

if [[ -z "${PASSWORD}" ]]; then
  (( ! ASSUME_YES )) || die "set BUNNY_PASSWORD for an unattended install"
  while true; do
    read -r -s -p "Password for ${USERNAME}: " PW1; echo
    read -r -s -p "Repeat password: " PW2; echo
    [[ "${PW1}" == "${PW2}" ]] || { warn "passwords do not match"; continue; }
    (( ${#PW1} >= 8 )) || { warn "use at least 8 characters"; continue; }
    PASSWORD="${PW1}"
    break
  done
fi
unset PW1 PW2 || true

# ---------------------------------------------------------------------------
# Partition, format, mount
# ---------------------------------------------------------------------------
log "partitioning ${DISK}"
sgdisk --zap-all "${DISK}"
sgdisk -n 1:0:+512M -t 1:ef00 -c 1:"BUNNY_ESP" "${DISK}"
sgdisk -n 2:0:0     -t 2:8300 -c 2:"BUNNY_ROOT" "${DISK}"
partprobe "${DISK}" 2>/dev/null || true
udevadm settle 2>/dev/null || sleep 1

log "creating filesystems"
mkfs.fat -F32 -n BUNNY_ESP "${ESP}"
mkfs.btrfs -f -L BUNNY_OS "${ROOT}"

log "creating Btrfs subvolumes"
mount "${ROOT}" "${TARGET}"
btrfs subvolume create "${TARGET}/@" >/dev/null
btrfs subvolume create "${TARGET}/@home" >/dev/null
btrfs subvolume create "${TARGET}/@var" >/dev/null
btrfs subvolume create "${TARGET}/@snapshots" >/dev/null
umount "${TARGET}"

OPTS="compress=zstd:3,noatime,space_cache=v2"
mount -o "${OPTS},subvol=@" "${ROOT}" "${TARGET}"
mkdir -p "${TARGET}/home" "${TARGET}/var" "${TARGET}/.snapshots" "${TARGET}/boot"
mount -o "${OPTS},subvol=@home" "${ROOT}" "${TARGET}/home"
mount -o "${OPTS},subvol=@var" "${ROOT}" "${TARGET}/var"
mount -o "${OPTS},subvol=@snapshots" "${ROOT}" "${TARGET}/.snapshots"
mount "${ESP}" "${TARGET}/boot"

# ---------------------------------------------------------------------------
# Copy the live image
# ---------------------------------------------------------------------------
log "copying the live system (this is the slow part)"
EXCLUDES=(
  --exclude=/dev/* --exclude=/proc/* --exclude=/sys/* --exclude=/run/*
  --exclude=/tmp/* --exclude=/mnt/* --exclude=/media/* --exclude=/lost+found
  --exclude=/var/tmp/* --exclude=/var/cache/pacman/pkg/* --exclude=/swapfile
  --exclude=/root/.cache/* --exclude=/home/*/.cache/*
)
rsync -aAXH --numeric-ids --info=progress2 "${EXCLUDES[@]}" / "${TARGET}/"

mkdir -p "${TARGET}/proc" "${TARGET}/sys" "${TARGET}/dev" "${TARGET}/run" "${TARGET}/tmp"
chmod 1777 "${TARGET}/tmp"

# ---------------------------------------------------------------------------
# Optional: carry the old /home across (drive swap / migration)
# ---------------------------------------------------------------------------
if [[ -n "${KEEP_HOME_FROM}" ]]; then
  KEEP_HOME_FROM="$(readlink -f "${KEEP_HOME_FROM}")"
  [[ -b "${KEEP_HOME_FROM}" ]] || die "migration source ${KEEP_HOME_FROM} is not a block device"
  [[ "${KEEP_HOME_FROM}" != "${DISK}" ]] || die "source and destination are the same disk"
  OLD_ROOT="$(part "${KEEP_HOME_FROM}" 2)"
  [[ -b "${OLD_ROOT}" ]] || die "${OLD_ROOT} does not exist; cannot read the old home"
  OLD_MNT="$(mktemp -d /run/bunny-oldhome.XXXXXX)"
  # Prefer the @home subvolume; fall back to a plain filesystem.
  if ! mount -o ro,subvol=@home "${OLD_ROOT}" "${OLD_MNT}" 2>/dev/null; then
    mount -o ro "${OLD_ROOT}" "${OLD_MNT}" \
      || die "cannot mount ${OLD_ROOT} read-only"
  fi
  OLD_HOME="${OLD_MNT}/home"
  [[ -d "${OLD_HOME}" ]] || OLD_HOME="${OLD_MNT}"
  log "migrating home from ${KEEP_HOME_FROM}"
  rsync -aHAX --numeric-ids --info=progress2 "${OLD_HOME}/" "${TARGET}/home/" \
    || warn "home migration finished with errors; check /home on the new disk"
  umount "${OLD_MNT}"
  rmdir "${OLD_MNT}" 2>/dev/null || true
  log "home migration complete"
fi

rm -f "${TARGET}/etc/fstab"
genfstab -U "${TARGET}" >> "${TARGET}/etc/fstab"
cp -f /etc/resolv.conf "${TARGET}/etc/resolv.conf"

ROOT_UUID="$(blkid -s UUID -o value "${ROOT}")"
[[ -n "${ROOT_UUID}" ]] || die "cannot read the new root UUID"

# Password travels through a 0600 file, not argv or the environment.
printf '%s\n' "${PASSWORD}" > "${TARGET}/root/.bunny-password"
chmod 0600 "${TARGET}/root/.bunny-password"
unset PASSWORD

# ---------------------------------------------------------------------------
# Post-install inside the target
# ---------------------------------------------------------------------------
log "configuring the installed system"
cat > "${TARGET}/root/bunny-postinstall.sh" <<POSTINSTALL
#!/usr/bin/env bash
set -Eeuo pipefail

ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc 2>/dev/null || true

echo '${LOCALE} UTF-8' > /etc/locale.gen
locale-gen
echo 'LANG=${LOCALE}' > /etc/locale.conf
echo '${HOSTNAME}' > /etc/hostname
cat > /etc/hosts <<'HOSTS'
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
HOSTS

id -u '${USERNAME}' >/dev/null 2>&1 || \
  useradd -m -c "Bunny OS" -G wheel,input,video,audio,render,storage,power,lp -s /bin/bash '${USERNAME}'
PASSWORD="\$(cat /root/.bunny-password)"
printf '%s:%s\n' '${USERNAME}' "\${PASSWORD}" | chpasswd
shred -u /root/.bunny-password 2>/dev/null || rm -f /root/.bunny-password
passwd -l root >/dev/null 2>&1 || true

echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel
rm -f /etc/sudoers.d/10-bunny-live

# The live image autologs into a TTY for recovery; an installed system must not.
rm -rf /etc/systemd/system/getty@tty2.service.d
rm -f /etc/systemd/system/bunny-live.target
rm -f /etc/systemd/system/multi-user.target.wants/bunny-live.target

# SDDM: autologin the chosen user into the Gaming session. The static
# 10-bunny.conf (Wayland, theme, power commands) ships with the image and is
# left untouched; bunny-sessiond owns the autologin drop-in from here on.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/20-bunny-session.conf <<SDDM
# Generated by bunny-install. bunny-sessiond rewrites this on mode changes.
[Autologin]
User=${USERNAME}
Session=bunny-gaming
Relogin=false
SDDM

# The daemon derives the SDDM user from session.conf; keep it in sync with the
# account that was just created.
if [[ -f /etc/bunny/session.conf ]]; then
  sed -i "s/^BUNNY_USER=.*/BUNNY_USER=${USERNAME}/" /etc/bunny/session.conf
fi

systemctl enable sddm.service
systemctl set-default graphical.target
systemctl enable bunny-sessiond.service
systemctl enable bunny-firstboot.service
# The account exists, so the interactive provisioner must stay dormant. The
# marker is what stops bunny-setup from holding tty1 on every boot.
install -d -m 0755 /var/lib/bunny
date -u +%FT%TZ > /var/lib/bunny/.account-ready
chmod 0644 /var/lib/bunny/.account-ready
systemctl enable bunny-setup.service
systemctl enable bunny-recovery.service
systemctl enable bunny-update.timer
systemctl enable bunny-health.timer
systemctl enable NetworkManager.service
systemctl enable bluetooth.service 2>/dev/null || true
systemctl enable power-profiles-daemon.service 2>/dev/null || true
systemctl enable fstrim.timer
systemctl enable systemd-timesyncd.service
systemctl --global enable bunny-bunbun.service 2>/dev/null || true
systemctl mask bunny-input-agent.service 2>/dev/null || true

# A handheld is offline more often than not. Anything ordered after these waits
# for a default route, which can add 90 seconds or hang forever on a train.
systemctl mask NetworkManager-wait-online.service \
               systemd-networkd-wait-online.service 2>/dev/null || true

# A new machine-id; the live one must not be shared between installs.
rm -f /etc/machine-id
systemd-machine-id-setup

rm -f /etc/bunny/allow-input-agent

mkinitcpio -P

KERNEL_PATH="\$(ls -1 /boot/vmlinuz-* 2>/dev/null | head -n1 || true)"
if [[ -n "\${KERNEL_PATH}" ]]; then
  KERNEL="\$(basename "\${KERNEL_PATH}")"
  KVER="\${KERNEL#vmlinuz-}"
  INITRD="/initramfs-\${KVER}.img"
  mkdir -p /boot/loader/entries
  cat > /boot/loader/entries/bunny-os.conf <<ENTRY
title   Bunny OS
linux   /\${KERNEL}
initrd  \${INITRD}
options root=UUID=${ROOT_UUID} rootflags=subvol=@ rw quiet splash loglevel=3 ${EXTRA_KERNEL_ARGS}
ENTRY
  cat > /boot/loader/loader.conf <<LOADER
default bunny-os.conf
timeout 3
console-mode max
editor no
LOADER
  # Second entry: same kernel, no graphical target, straight into the menu.
  cat > /boot/loader/entries/bunny-os-recovery.conf <<ENTRY2
title   Bunny OS (Recovery and Maintenance)
linux   /\${KERNEL}
initrd  \${INITRD}
options root=UUID=${ROOT_UUID} rootflags=subvol=@ rw quiet splash loglevel=3 bunny.recovery=1 systemd.unit=multi-user.target ${EXTRA_KERNEL_ARGS}
ENTRY2
  bootctl --path=/boot install
else
  echo "WARNING: no kernel found in /boot; systemd-boot was not configured" >&2
fi

chown -R '${USERNAME}':'${USERNAME}' /home/'${USERNAME}'
POSTINSTALL
chmod 0755 "${TARGET}/root/bunny-postinstall.sh"

arch-chroot "${TARGET}" /root/bunny-postinstall.sh
rm -f "${TARGET}/root/bunny-postinstall.sh"

# ---------------------------------------------------------------------------
# Finish
# ---------------------------------------------------------------------------
log "unmounting"
sync
umount -R "${TARGET}"

cat <<EOF

  Bunny OS is installed on ${DISK}.

    root UUID   ${ROOT_UUID}
    bootloader  systemd-boot (UEFI)
    user        ${USERNAME}
    login       graphical, Gaming Mode by default

  Remove the USB stick and reboot. The first boot runs bunny-firstboot
  (Flatpak setup, zram, sysctl tuning) and can take a few minutes.

EOF
