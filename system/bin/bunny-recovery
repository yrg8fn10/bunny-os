#!/usr/bin/env bash
# =============================================================================
#  bunny-recovery — console recovery and maintenance menu.
#
#  Reached either from the "Recovery & Maintenance" systemd-boot entry
#  (bunny.recovery=1 on the kernel command line) or by running it directly.
#  It is deliberately a plain bash TUI: no dialog/whiptail dependency, no
#  network, and every destructive action re-prompts.
#
#  A USB keyboard is required - the Deck's controls are not usable here.
#
#  Failure policy: this menu must never die. A dead menu means tty1 falls back
#  to a getty, and root is locked on both the live image and an installed
#  system, so the only way out is another console. Every action therefore runs
#  in a subshell, failures are logged with a line number and shown on screen,
#  and a closed stdin redraws instead of exiting.
#
#  Log: /run/bunny/recovery.log (falls back to /tmp). `--self-test` prints the
#  environment report without touching any disk.
# =============================================================================
set -Eeuo pipefail

# systemd services start with a minimal environment: no HOME, sometimes no
# PATH beyond the defaults. Pin both before anything calls a tool by name.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export TERM="${TERM:-linux}"
export HOME="${HOME:-/root}"
export LANG="${LANG:-C.UTF-8}"

BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[1;31m'; GRN=$'\033[1;32m'
YEL=$'\033[1;33m'; CYA=$'\033[1;36m'; RST=$'\033[0m'

LOG_DIR="/run/bunny"
LOG_FILE="${LOG_DIR}/recovery.log"
if ! { mkdir -p "${LOG_DIR}" 2>/dev/null && : >>"${LOG_FILE}" 2>/dev/null; }; then
  LOG_FILE="/tmp/bunny-recovery.log"
  : >>"${LOG_FILE}" 2>/dev/null || LOG_FILE="/dev/null"
fi

log()  { printf '%s [recovery] %s\n' "$(date -u +%FT%TZ)" "$*" >>"${LOG_FILE}"; }
line() { printf '%s\n' "${DIM}────────────────────────────────────────────────────────────${RST}"; }
hdr()  { printf '\n%s%s%s\n' "${CYA}${BOLD}" "$*" "${RST}"; line; }
ok()   { printf '  %s✓%s %s\n' "${GRN}" "${RST}" "$*"; }
bad()  { printf '  %s✗%s %s\n' "${RED}" "${RST}" "$*"; log "FAIL $*"; }
info() { printf '  %s·%s %s\n' "${DIM}" "${RST}" "$*"; }
err()  { bad "$*"; }

on_error() {
  local rc="$1" lineno="$2" cmd="$3"
  err "line ${lineno}: '${cmd}' exited ${rc}"
  info "details: ${LOG_FILE}"
}
trap 'on_error $? ${LINENO} "${BASH_COMMAND}"' ERR

# ask writes its prompt to the terminal and returns 3 when stdin is closed, so
# callers can tell "user pressed Enter" (empty answer, default applies) from
# "nobody is at the keyboard" (EOF). A Ctrl-D used to end the whole menu.
ask() {
  local p="$1" d="${2:-}" a=""
  if ! read -r -p "  ${p}${d:+ [$d]}: " a; then
    printf '\n'
    return 3
  fi
  printf '%s' "${a:-$d}"
}

pause() { read -r -p "  ${DIM}press Enter to continue${RST} " _ || true; }

ensure_tty() {
  [[ -t 0 ]] && return 0
  if [[ -c /dev/tty1 ]]; then
    # The unit normally supplies tty1, but a manual `bunny-recovery` from a
    # script or an ssh session arrives with a pipe or /dev/null on stdin.
    exec </dev/tty1 >/dev/tty1 2>&1 || true
    [[ -t 0 ]] && return 0
  fi
  return 1
}

need_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    local self
    self="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "$0")"
    exec sudo -- "${self}" "$@"
  fi
}

live_check() {
  # Install and migration need the live medium (they copy the running root and
  # refuse to write to the stick they booted from). Repair and the shell work on
  # an installed system too, so a missing /run/archiso is not fatal here.
  if [[ -d /run/archiso ]]; then LIVE=1; else LIVE=0; fi
  log "live=${LIVE} tty=$(tty 2>/dev/null || echo none) euid=${EUID} term=${TERM}"
}

need_live() {
  if (( ! LIVE )); then
    bad "this action needs the Bunny OS live USB"
    pause
    return 1
  fi
}

# Disks the user may operate on: everything except the stick we booted from.
candidate_disks() {
  local live_src live_pk live_disk=""
  live_src="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
  if [[ -b "${live_src}" ]]; then
    live_pk="$(lsblk -no PKNAME "${live_src}" 2>/dev/null | head -n1 || true)"
    [[ -n "${live_pk}" ]] && live_disk="/dev/${live_pk}"
  fi
  lsblk -dpno NAME,SIZE,TRAN,MODEL 2>/dev/null | while read -r name size tran model; do
    [[ "${name}" == "${live_disk}" ]] && continue
    [[ "${tran}" == "usb" ]] && continue
    printf '%s\t%s\t%s\n' "${name}" "${size}" "${model:-unknown}"
  done
}

# Sets PICKED_DISK. It deliberately does not print the choice on stdout: the
# old version was called as `disk="$(pick_disk)"`, which captured the numbered
# list along with the device name, so the "type the disk name to confirm"
# prompt could never match and the action silently cancelled itself back to the
# menu.
PICKED_DISK=""
pick_disk() {
  local -a disks=()
  mapfile -t disks < <(candidate_disks)
  if (( ${#disks[@]} == 0 )); then
    bad "no internal disk found (USB sticks are hidden on purpose)"
    log "candidate_disks returned nothing; lsblk: $(lsblk -dno NAME 2>/dev/null | tr '\n' ' ')"
    return 1
  fi
  local i n
  for i in "${!disks[@]}"; do
    printf '   %d) %s\n' "$((i + 1))" "${disks[$i]}"
  done
  if ! n="$(ask "Disk number" "1")"; then
    bad "input closed"; return 1
  fi
  n="${n//[[:space:]]/}"
  [[ "${n}" =~ ^[0-9]+$ ]] || { bad "'${n}' is not a number"; return 1; }
  (( n >= 1 && n <= ${#disks[@]} )) || { bad "${n} is out of range (1-${#disks[@]})"; return 1; }
  PICKED_DISK="${disks[$((n - 1))]%%$'\t'*}"
  log "disk selected: ${PICKED_DISK}"
}

# The installer is a child process, never an exec: an exec failure used to take
# the menu with it, and on this console that means a locked root login prompt.
run_installer() {
  local -a args=("$@")
  local rc=0
  log "installer start: ${args[*]}"
  printf '  %s·%s starting installer (output is mirrored to %s)\n' "${DIM}" "${RST}" "${LOG_FILE}"
  /usr/local/bin/bunny-install "${args[@]}" 2>&1 | tee -a "${LOG_FILE}" || rc=$?
  log "installer exit: ${rc}"
  return "${rc}"
}

# ---------------------------------------------------------------------------
# 1. Clean install
# ---------------------------------------------------------------------------
action_install() {
  hdr "Clean install — replace the OS with Bunny OS"
  need_live || return 0
  cat <<'EOF'
  This erases the selected internal disk completely: partition table,
  every partition, every file. There is no dual boot and no encryption.

  Your SteamOS install, games and saves on that disk are destroyed. If you
  have not made a SteamOS recovery USB yet, stop and do that first.
EOF
  pick_disk || { pause; return 0; }
  local disk="${PICKED_DISK}"
  info "target: ${disk}"
  local confirm
  if ! confirm="$(ask "Type the disk name to confirm (${disk})")"; then
    bad "input closed"; pause; return 0
  fi
  if [[ "${confirm}" != "${disk}" ]]; then
    bad "cancelled - expected '${disk}'"
    pause
    return 0
  fi
  local rc=0
  run_installer --disk "${disk}" || rc=$?
  if (( rc == 0 )); then
    ok "installation finished"
    log "install succeeded on ${disk}"
    pause
    sync
    exec systemctl --no-block reboot
  fi
  bad "installer failed with status ${rc}"
  info "the disk may be partially written; the log is at ${LOG_FILE}"
  pause
}

# ---------------------------------------------------------------------------
# 2. Repair / integrity check
# ---------------------------------------------------------------------------
part_of() {
  local disk="$1" n="$2"
  if [[ "${disk}" =~ [0-9]$ ]]; then printf '%s' "${disk}p${n}"; else printf '%s' "${disk}${n}"; fi
}

action_repair() {
  hdr "Repair — verify and rebuild boot components"
  pick_disk || { pause; return 0; }
  local disk="${PICKED_DISK}"
  local esp root
  esp="$(part_of "${disk}" 1)"
  root="$(part_of "${disk}" 2)"

  if [[ ! -b "${root}" ]]; then
    bad "${root} does not exist - is this a Bunny OS disk?"
    pause; return 0
  fi

  local fails=0
  hdr "Checking ${disk}"

  # Partition table and filesystems (read-only).
  if sgdisk -v "${disk}" >/dev/null 2>&1; then
    ok "GPT is consistent"
  else
    bad "GPT reports problems"; fails=$((fails + 1))
  fi
  if [[ -b "${esp}" ]]; then
    if fsck.vfat -n "${esp}" >/dev/null 2>&1; then
      ok "ESP filesystem clean (${esp})"
    else
      bad "ESP filesystem has errors"; fails=$((fails + 1))
    fi
  else
    bad "no ESP at ${esp}"; fails=$((fails + 1))
  fi

  # Mount read-only and look at the tree.
  mkdir -p /mnt/bunny-repair
  if ! mount -o ro,subvol=@ "${root}" /mnt/bunny-repair 2>/dev/null; then
    bad "cannot mount ${root} (subvol=@)"
    pause; return 0
  fi
  local m=/mnt/bunny-repair

  if [[ -x "${m}/usr/bin/bash" ]]; then
    ok "root filesystem populated"
  else
    bad "root filesystem looks empty"; fails=$((fails + 1))
  fi

  local kernel initrd
  kernel="$(find "${m}/boot" -maxdepth 1 -name 'vmlinuz-*' 2>/dev/null | head -n1 || true)"
  initrd="$(find "${m}/boot" -maxdepth 1 -name 'initramfs-*' 2>/dev/null | head -n1 || true)"
  if [[ -n "${kernel}" && -n "${initrd}" ]]; then
    ok "kernel and initramfs present"
  else
    bad "kernel or initramfs missing from /boot"; fails=$((fails + 1))
  fi

  if [[ -f "${m}/boot/loader/loader.conf" ]]; then
    ok "systemd-boot config present"
  else
    bad "no /boot/loader/loader.conf"; fails=$((fails + 1))
  fi
  if [[ -d "${m}/boot/loader/entries" ]]; then
    ok "loader entries present"
  else
    bad "no loader entries directory"; fails=$((fails + 1))
  fi

  # fstab references must resolve, otherwise the next boot hangs on a device.
  local fstab_bad=0 uuid
  if [[ -f "${m}/etc/fstab" ]]; then
    while read -r uuid; do
      [[ -n "${uuid}" ]] || continue
      blkid -U "${uuid}" >/dev/null 2>&1 || { bad "fstab UUID ${uuid} not found"; fstab_bad=1; }
    done < <(sed -nE 's#^UUID=([^[:space:]]+).*#\1#p' "${m}/etc/fstab")
    if (( fstab_bad )); then
      fails=$((fails + 1))
    else
      ok "all fstab UUIDs resolve"
    fi
  else
    bad "no /etc/fstab"; fails=$((fails + 1))
  fi

  info "live root: mounted read-only at ${m}"
  if (( fails > 0 )); then
    printf '\n  %s%d problem(s) found.%s\n' "${YEL}" "${fails}" "${RST}"
  else
    printf '\n  %sNo problems found.%s\n' "${GRN}" "${RST}"
  fi
  log "repair scan of ${disk}: ${fails} problem(s)"

  local do_fix
  if ! do_fix="$(ask "Rebuild initramfs and reinstall the bootloader now? (y/N)" "N")"; then
    do_fix="N"
  fi
  if [[ "${do_fix}" =~ ^[Yy]$ ]]; then
    umount -R "${m}" 2>/dev/null || true
    if mount -o "subvol=@" "${root}" "${m}"; then
      # systemd-boot must be written to the ESP, not to /boot on the root
      # filesystem, so the ESP has to be mounted over it first.
      if [[ -b "${esp}" ]]; then
        mount "${esp}" "${m}/boot" 2>/dev/null \
          || bad "could not mount the ESP at ${m}/boot"
      fi
      info "rebuilding initramfs"
      if arch-chroot "${m}" mkinitcpio -P; then ok "initramfs rebuilt"; else bad "mkinitcpio failed"; fi
      info "reinstalling systemd-boot"
      if arch-chroot "${m}" bootctl --path=/boot install; then
        ok "systemd-boot reinstalled"
      else
        bad "bootctl failed"
      fi
      umount -R "${m}" 2>/dev/null || true
    else
      bad "could not remount read-write"
    fi
  fi

  umount -R "${m}" 2>/dev/null || true
  rmdir "${m}" 2>/dev/null || true
  pause
}

# ---------------------------------------------------------------------------
# 3. Migration — new disk, keep the old home
# ---------------------------------------------------------------------------
action_migrate() {
  hdr "Migration — move Bunny OS to another disk, keep /home"
  need_live || return 0
  cat <<'EOF'
  Use this when you are swapping the drive: the system goes to a new disk,
  the old disk's /home (games, saves, settings) is copied across afterwards.

  The destination disk is erased. The source disk is mounted read-only and
  never written to, so you can retry or fall back.
EOF
  local src dst
  info "source: the existing Bunny OS disk (read only)"
  pick_disk || { pause; return 0; }
  src="${PICKED_DISK}"
  hdr "Destination"
  pick_disk || { pause; return 0; }
  dst="${PICKED_DISK}"
  if [[ "${src}" == "${dst}" ]]; then
    bad "source and destination are the same disk"; pause; return 0
  fi
  local confirm
  if ! confirm="$(ask "Type the DESTINATION disk name to confirm (${dst})")"; then
    bad "input closed"; pause; return 0
  fi
  if [[ "${confirm}" != "${dst}" ]]; then
    bad "cancelled - expected '${dst}'"; pause; return 0
  fi
  local rc=0
  run_installer --disk "${dst}" --keep-home-from "${src}" || rc=$?
  if (( rc == 0 )); then
    ok "migration finished"; pause
    sync
    exec systemctl --no-block reboot
  fi
  bad "installer failed with status ${rc}"
  info "the log is at ${LOG_FILE}"
  pause
}

# ---------------------------------------------------------------------------
# 4. Shell
# ---------------------------------------------------------------------------
action_shell() {
  hdr "Shell"
  if ! ensure_tty; then
    bad "no interactive terminal available (stdin is not a tty)"
    info "boot the Recovery entry again, or use tty2 as user 'bunny'"
    log "shell refused: stdin is not a tty"
    pause
    return 0
  fi
  # A shell as root with no writable HOME drops into '/', cannot save history
  # and prints "cannot set terminal process group" from a stale TTY. Check the
  # pieces instead of letting bash fail one at a time.
  if [[ ! -x /usr/bin/bash ]]; then
    bad "/usr/bin/bash is missing"; pause; return 0
  fi
  if [[ ! -d "${HOME}" || ! -w "${HOME}" ]]; then
    info "HOME=${HOME} is not writable, using /tmp"
    HOME=/tmp
    export HOME
  fi
  if [[ ! -t 1 ]]; then
    info "stdout is not a terminal; output may not appear until exit"
  fi
  info "root shell - type 'exit' to return to the menu"
  info "PATH=${PATH}"
  log "shell start: HOME=${HOME} TERM=${TERM}"
  local rc=0
  # -l reads /etc/profile (PATH, aliases); -i keeps job control and history.
  # If the login profile is broken, fall back to a plain interactive shell
  # rather than dropping the user back to the menu with no explanation.
  bash -l -i || rc=$?
  if (( rc != 0 )); then
    bad "shell exited with status ${rc}"
    log "shell exit ${rc}; retrying without /etc/profile"
    printf '  %s·%s retrying with a plain interactive shell\n' "${DIM}" "${RST}"
    rc=0
    bash --noprofile --norc -i || rc=$?
    (( rc == 0 )) || err "shell still failing (status ${rc}) - see ${LOG_FILE}"
  fi
  log "shell exit: ${rc}"
  pause
}

# ---------------------------------------------------------------------------
# Self-test — what a failed action needs to be debuggable on the Deck
# ---------------------------------------------------------------------------
self_test() {
  local fails=0
  hdr "Self test"
  if [[ "${EUID}" -eq 0 ]]; then ok "running as root"; else bad "not root"; fails=$((fails + 1)); fi
  if (( LIVE )); then ok "live medium detected (/run/archiso)"; else info "not a live medium (install disabled)"; fi
  if [[ -t 0 ]]; then ok "stdin is a terminal ($(tty 2>/dev/null || echo tty))"; else bad "stdin is not a terminal"; fails=$((fails + 1)); fi
  if [[ -w "$(dirname "${LOG_FILE}")" ]]; then ok "log writable at ${LOG_FILE}"; else bad "log not writable"; fails=$((fails + 1)); fi
  local tool
  for tool in bash tee sgdisk mkfs.fat mkfs.btrfs mount umount lsblk rsync \
              genfstab arch-chroot blkid bootctl mkinitcpio partprobe \
              fsck.vfat findmnt numfmt; do
    if command -v "${tool}" >/dev/null 2>&1; then
      ok "${tool}"
    else
      bad "${tool} missing"; fails=$((fails + 1))
    fi
  done
  printf '\n'
  info "disks the menu would offer:"
  candidate_disks | sed 's/^/    /' || true
  printf '\n'
  if (( fails == 0 )); then
    printf '  %sall checks passed%s\n' "${GRN}" "${RST}"
    log "self-test: pass"
    return 0
  fi
  printf '  %s%d check(s) failed%s\n' "${RED}" "${fails}" "${RST}"
  log "self-test: ${fails} failure(s)"
  return 1
}

# ---------------------------------------------------------------------------
# Menu
# ---------------------------------------------------------------------------
run_action() {
  local fn="$1" rc=0
  # A subshell keeps an action's exit from killing the menu: set -e inside it
  # aborts only the subshell, and the trap still records the line.
  ( "${fn}" ) || rc=$?
  if (( rc != 0 )); then
    err "${fn} failed (status ${rc})"
    info "details: ${LOG_FILE}"
    pause
  fi
}

menu() {
  while true; do
    hdr "Bunny OS — Recovery & Maintenance"
    if (( LIVE )); then
      info "running from the live USB: install, migration and repair available"
    else
      info "running from an installed system: repair and shell available"
      info "boot the live USB for install or migration"
    fi
    printf '  %slog: %s%s\n' "${DIM}" "${LOG_FILE}" "${RST}"
    cat <<'EOF'
   1) Clean install          erase a disk, install Bunny OS
   2) Repair                 check filesystems, bootloader, fstab
   3) Migration              install to a new disk, keep your /home
   4) Shell                  root shell with the live tools
   5) System information     disks, memory, live medium, self test
   0) Reboot
EOF
    local c
    if ! c="$(ask "Choice" "0")"; then
      # Ctrl-D closes the read, not the menu. Redraw instead of exiting.
      info "no input (Ctrl-D); redrawing"
      sleep 1
      continue
    fi
    c="${c//[[:space:]]/}"
    case "${c}" in
      1) run_action action_install ;;
      2) run_action action_repair ;;
      3) run_action action_migrate ;;
      4) run_action action_shell ;;
      5) hdr "System information"
         lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT,LABEL || true
         free -h || true
         printf '\n'
         self_test || true
         pause ;;
      0) log "reboot requested"; sync; exec systemctl --no-block reboot ;;
      *) bad "unknown choice '${c}'" ;;
    esac
  done
}

need_root "$@"
live_check

if [[ "${1:-}" == "--self-test" || "${1:-}" == "--check" ]]; then
  ensure_tty && printf '\n'
  self_test
  exit $?
fi

if ! ensure_tty; then
  printf 'bunny-recovery: no terminal (stdin is not a tty)\n' >&2
  log "abort: no terminal"
  exit 1
fi

menu
