#!/usr/bin/env bash
# =============================================================================
#  bunny-desktop-theme — apply the pastel Bunny OS workspace in Desktop Mode.
#
#  Called from bunny-session after Plasma starts. Plasma owns the wallpaper via
#  plasmashell's DBus interface, so this retries for a few seconds instead of
#  assuming the shell is ready. Everything here is best effort: failing to set
#  a wallpaper must never affect the session.
# =============================================================================
set -uo pipefail

# Preferred order: the approved pastel desktop art first, then the older set.
WALLPAPER=""
for _d in /usr/share/backgrounds/bunny-os /var/lib/bunny/os/wallpapers; do
  for _n in bunny-desktop.png bunny-glow.png bunny-meadow.png; do
    if [[ -f "${_d}/${_n}" ]]; then
      WALLPAPER="${_d}/${_n}"
      break 2
    fi
  done
done
ACCENT="255,179,217"
STATE_DIR="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/bunny"
LOG_FILE="${STATE_DIR}/desktop-theme.log"

mkdir -p "${STATE_DIR}" 2>/dev/null || true
log() {
  local msg
  msg="$(date -u +%FT%TZ) [desktop-theme] $*"
  printf '%s\n' "${msg}" >&2
  printf '%s\n' "${msg}" >> "${LOG_FILE}" 2>/dev/null || true
}

[[ -f "${WALLPAPER}" ]] || { log "wallpaper missing under /usr/share/backgrounds/bunny-os and /var/lib/bunny/os/wallpapers"; exit 0; }

# Stage the CSS Loader (Decky) theme so Game Mode can pick it up when Decky is on.
command -v /usr/bin/bunny-decky-theme >/dev/null 2>&1 && /usr/bin/bunny-decky-theme || true

applied=0
if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
  for _ in $(seq 1 20); do
    if plasma-apply-wallpaperimage "${WALLPAPER}" >/dev/null 2>&1; then
      applied=1
      log "wallpaper applied"
      break
    fi
    sleep 1
  done
fi
(( applied )) || log "plasma-apply-wallpaperimage unavailable or refused the image"

# Accent colour: Plasma 6 reads General/AccentColor from kdeglobals. Only write
# it when the key is absent or still the default, so a user choice survives.
if command -v kwriteconfig6 >/dev/null 2>&1; then
  current="$(kreadconfig6 --file kdeglobals --group General --key AccentColor 2>/dev/null || true)"
  if [[ -z "${current}" || "${current}" == "0,0,0" ]]; then
    kwriteconfig6 --file kdeglobals --group General --key AccentColor "${ACCENT}" \
      && log "accent colour set to pastel pink"
  fi
fi

# Cursor theme: point Plasma (X11 and Wayland) and GTK apps at the Bunny set.
if [[ -d /usr/share/icons/BunnyCursor/cursors ]]; then
  for kw in kwriteconfig6 kwriteconfig5; do
    if command -v "${kw}" >/dev/null 2>&1; then
      "${kw}" --file kcminputrc --group Mouse --key cursorTheme BunnyCursor 2>/dev/null \
        && log "cursor theme set to BunnyCursor (${kw})" || true
    fi
  done
  for conf in "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/gtk-3.0/settings.ini" \
              "${XDG_CONFIG_HOME:-${HOME:-/tmp}/.config}/gtk-4.0/settings.ini"; do
    mkdir -p "$(dirname "${conf}")" 2>/dev/null || true
    if grep -q '^gtk-cursor-theme-name=' "${conf}" 2>/dev/null; then
      sed -i 's/^gtk-cursor-theme-name=.*/gtk-cursor-theme-name=BunnyCursor/' "${conf}" 2>/dev/null || true
    else
      printf 'gtk-cursor-theme-name=BunnyCursor\n' >> "${conf}" 2>/dev/null || true
    fi
  done
  log "gtk cursor theme set to BunnyCursor"
else
  log "BunnyCursor theme not installed; keeping the host cursor"
fi

exit 0
