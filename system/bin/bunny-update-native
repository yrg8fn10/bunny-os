#!/usr/bin/env bash
# =============================================================================
#  bunny-update-native — Bunny OS 2.0 native updater (design skeleton).
#
#  Windows-Update style, zero console: check the channel, pull the image,
#  verify the digest, stage the second boot entry, let Bun Bun announce it,
#  reboot on consent, health-check, auto-rollback on failure.
#  State machine and plumbing are real; deploy/reboot bodies are NOT-IMPLEMENTED
#  until the Mon Nov 16 prototype milestone. See docs/NATIVE-UPDATER.md.
#
#  Usage: bunny-update-native [--check|--stage|--apply|--rollback|--status]
#                             [--channel deck-stable|deck-nvidia-stable] [--yes]
# =============================================================================
set -Eeuo pipefail

CHANNEL="deck-stable"
ACTION="status"
ASSUME_YES=0

while (( $# > 0 )); do
  case "$1" in
    --check)   ACTION="check"; shift ;;
    --stage)   ACTION="stage"; shift ;;
    --apply)   ACTION="apply"; shift ;;
    --rollback) ACTION="rollback"; shift ;;
    --status)  ACTION="status"; shift ;;
    --channel) CHANNEL="${2:?}"; shift 2 ;;
    --yes|-y)  ASSUME_YES=1; shift ;;
    --help|-h) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "bunny-update-native: unknown argument $1" >&2; exit 2 ;;
  esac
done

STATE_DIR="/var/lib/bunny-update"
STATE_FILE="${STATE_DIR}/state.json"
CACHE_DIR="/var/cache/bunny-update"

log() { printf '[bunny-update-native] %s\n' "$*"; }
die() { printf '[bunny-update-native] ERROR: %s\n' "$*" >&2; exit 1; }

[[ "$(id -u)" -eq 0 ]] || die "must run as root"

# --- state ---------------------------------------------------------------------
# Crash-safe: every phase transition rewrites state.json atomically, so a power
# cut lands the machine back in a known phase (watchdog protocol).
write_state() { # $1=phase $2=version $3=extra json or ''
  local phase="$1" version="${2:-null}" extra="${3:-}"
  mkdir -p "${STATE_DIR}"
  local tmp="${STATE_FILE}.tmp.$$"
  python3 - "$tmp" "$phase" "$version" "$extra" <<'PY'
import json, sys
tmp, phase, version, extra = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
state = {"phase": phase, "version": version, "updated_at": __import__("time").time()}
if extra:
    try: state.update(json.loads(extra))
    except json.JSONDecodeError: pass
json.dump(state, open(tmp, "w"))
PY
  mv "${tmp}" "${STATE_FILE}"
}

read_state() {
  [[ -f "${STATE_FILE}" ]] && cat "${STATE_FILE}" || echo '{"phase":"IDLE"}'
}

# --- CHECK ---------------------------------------------------------------------
# Read the channel manifest (version, tag, sha256, size, bun bun changelog line).
# No network → stay IDLE; a failed check never breaks the timer.
do_check() {
  log "CHECK: reading channel manifest for ${CHANNEL} (NOT-IMPLEMENTED)"
  # TODO(prototype): fetch manifest, compare running version, write_state CHECK
  write_state "CHECK" "null" "{\"channel\": \"${CHANNEL}\", \"result\": \"stub\"}"
}

# --- PULL ----------------------------------------------------------------------
# Background, resumable fetch. A dead download resumes from its exact byte
# offset; a partial file is never trusted.
do_pull() {
  log "PULL: resumable fetch to ${CACHE_DIR} (NOT-IMPLEMENTED)"
  # TODO(prototype): offset-aware ranged download + state checkpointing
  write_state "PULL" "null" "{\"channel\": \"${CHANNEL}\", \"result\": \"stub\"}"
}

# --- VERIFY --------------------------------------------------------------------
do_verify() {
  log "VERIFY: sha256 against manifest (NOT-IMPLEMENTED)"
  write_state "VERIFY" "null" "{\"result\": \"stub\"}"
}

# --- STAGE ---------------------------------------------------------------------
do_stage() {
  log "STAGE: deploy into the second boot entry, old boot retained (NOT-IMPLEMENTED)"
  # TODO(prototype): OSTree deployment on the OSTree base; Btrfs snapshot +
  # boot-entry swap on the pacstrap base. Fully reversible until APPLY.
  write_state "STAGE" "null" "{\"result\": \"stub\"}"
}

# --- ANNOUNCE + APPLY (reboot on consent) --------------------------------------
do_apply() {
  # Bun Bun announces via the agent (127.0.0.1:8422) + panel toast BEFORE this.
  if (( ! ASSUME_YES )); then
    log "APPLY: Bun Bun asks first — re-run with --yes once the user consents (stub)"
    exit 0
  fi
  log "APPLY: single reboot into the staged entry (NOT-IMPLEMENTED)"
  write_state "APPLY" "null" "{\"result\": \"stub\"}"
}

# --- HEALTH + ROLLBACK ----------------------------------------------------------
do_rollback() {
  log "ROLLBACK: select previous boot entry, mark image bad in manifest state (NOT-IMPLEMENTED)"
  write_state "ROLLBACK" "null" "{\"result\": \"stub\"}"
}

case "${ACTION}" in
  check)    do_check ;;
  pull)     do_pull ;;
  stage)    do_stage ;;
  apply)    do_apply ;;
  rollback) do_rollback ;;
  status)   echo "${STATE_FILE}: $(read_state)" ;;
esac
