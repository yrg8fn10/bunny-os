[Unit]
Description=Bunny OS Recovery & Maintenance
Documentation=file:///usr/share/doc/bunny-os/STEAMDECK.md
# Only active when the "Recovery & Maintenance" boot entry was chosen. The
# entry adds bunny.recovery=1 and systemd.unit=multi-user.target, so on a
# normal boot this unit is not pulled in at all.
ConditionKernelCommandLine=bunny.recovery=1
After=local-fs.target systemd-udev-settle.service
Before=multi-user.target
Conflicts=display-manager.service getty@tty1.service
# The menu is the only thing on tty1, so never give up restarting it: if it
# dies, the console falls back to a getty and root is locked on both the live
# image and an installed system.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/bunny-recovery
# tty-force takes the console even if a getty is still holding it. Plain "tty"
# makes systemd fail the unit in that race, which looks exactly like a locked
# recovery environment.
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
Nice=-5
# systemd starts services with no HOME and a minimal PATH; the menu and the
# root shell it spawns both need the full system path and a usable TERM.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HOME=/root
Environment=TERM=linux
Environment=LANG=C.UTF-8
Restart=on-failure
RestartSec=2
# The menu holds multi-user.target open until the user reboots or quits. That
# is intentional: the login manager is never started on this entry.

[Install]
WantedBy=multi-user.target
