[Unit]
Description=Bunny OS First Boot Provisioning
Documentation=file:///usr/share/doc/bunny-os/BUILD.md
ConditionPathExists=!/var/lib/bunny/.firstboot-done
After=network-online.target
Wants=network-online.target
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/bunny-firstboot
RemainAfterExit=yes
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
